<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>consent-portal</display-name>

    <!-- Defaults; override via <IS_HOME>/repository/conf/dpdp-portal.properties. -->
    <context-param>
        <param-name>identity.server.base.url</param-name>
        <param-value>https://localhost:9443</param-value>
    </context-param>
    <context-param>
        <param-name>identity.server.internal.base.url</param-name>
        <param-value>https://localhost:9443</param-value>
    </context-param>
    <context-param>
        <param-name>oauth.client.id</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>oauth.client.secret</param-name>
        <param-value></param-value>
    </context-param>
    <!--
      Scopes requested at login. The portal's own screens are scope-gated, so a
      scope missing here is not a permission error later - the navigation entry
      simply never appears. The administrative and catalog entries need the
      :any and catalog scopes, not just the :self ones.
    -->
    <context-param>
        <param-name>oauth.scopes</param-name>
        <param-value>openid email profile internal_login portal:consents:read:self portal:consents:write:self portal:consents:approve:self portal:consents:read:any portal:consents:write:any portal:purposes:read portal:purposes:write portal:elements:read portal:elements:write portal:profile:read:self portal:profile:write:self portal:profile:delete:self portal:profile:read:any portal:profile:write:any</param-value>
    </context-param>
    <context-param>
        <param-name>cookie.secure</param-name>
        <param-value>true</param-value>
    </context-param>

    <!--
      Nominee delegation (DPDP nominee feature).

      The service URL and internal key are left empty deliberately. The acting
      routes stay closed until a deployment supplies both, which is the correct
      posture for an installation that has not configured delegation: a
      half-configured gate must never resolve to "allowed".
    -->
    <context-param>
        <param-name>nominee.service.url</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>nominee.gate.api.key</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>nominee.gate.timeout.seconds</param-name>
        <param-value>3</param-value>
    </context-param>
    <!--
      Redirect target for the impersonation authorization step. Must be
      registered on the Identity Server application as an allowed callback.
    -->
    <context-param>
        <param-name>impersonation.redirect.uri</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>impersonation.scope</param-name>
        <param-value>internal_user_impersonate</param-value>
    </context-param>
    <!--
      The role gating the administrative nominee screens. Evaluated live on
      every admin request, so revoking it takes effect on the next call rather
      than at token expiry.
    -->
    <context-param>
        <param-name>admin.role.name</param-name>
        <param-value>PortalAdmin</param-value>
    </context-param>
    <!--
      Namespace for portal-owned scopes. Set empty when the identity provider
      issues unprefixed scopes.
    -->
    <context-param>
        <param-name>scope.prefix</param-name>
        <param-value>portal:</param-value>
    </context-param>
    <!--
      Service credentials for SCIM2 directory lookups. Resolving a user who is
      not the caller is not something the caller's own token may do, so these
      are a separate client-credentials identity. They fall back to the portal's
      own OAuth client when one application serves both purposes.
    -->
    <context-param>
        <param-name>scim.client.id</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>scim.client.secret</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>scim.custom.schema.urn</param-name>
        <param-value>urn:scim:wso2:schema</param-value>
    </context-param>
    <!--
      The Consent Server that owns consent records. The acting routes read and
      write consents through this service rather than the Identity Server's own
      consent APIs, so a nominee acting for an owner reaches exactly the same
      records, through exactly the same API, as the Go BFF does.
    -->
    <context-param>
        <param-name>consent.server.url</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>consent.server.placeholder.client.id</param-name>
        <param-value></param-value>
    </context-param>

    <!--
      Client-side routes are served by SpaServlet, which is mapped at the
      context root. No 404 error-page fallback is used: it would answer a
      deep link with an error status, and it would turn a missing API route
      into an HTML page instead of the JSON envelope the SPA expects.
    -->
</web-app>
