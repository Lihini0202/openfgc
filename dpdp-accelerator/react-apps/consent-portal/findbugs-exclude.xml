<!--
  Reviewed SpotBugs/FindSecBugs suppressions for the consent portal BFF.

  Every entry below names a specific class and bug pattern and carries the
  reason it is safe here. Analysis runs with failOnError=true, so anything not
  listed fails the build: add a new entry only after establishing the finding is
  a false positive, never to silence a real one.
-->
<FindBugsFilter>

    <!--
      The BFF is a proxy: it reads request parameters and query strings by
      design and forwards them to the Identity Server, which authenticates and
      authorizes every call. Paths are constrained before use - AdminApiServlet
      validates against SAFE_PATH and an explicit translation table, and
      MyConsentsServlet matches consent ids against CONSENT_ID - so tainted
      input never reaches a sensitive sink unchecked.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.AuthRefreshServlet"/>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.MyConsentsServlet"/>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.OAuthCallbackServlet"/>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.AdminApiServlet"/>
        <Bug pattern="SERVLET_QUERY_STRING"/>
    </Match>

    <!--
      The Authorization header is read deliberately: it carries part one of the
      split access token, which is meaningless without the HttpOnly part two
      cookie. Both halves are rejoined and handed to the Identity Server for
      validation - the portal never trusts the header on its own.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.util.AuthUtil"/>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>

    <!--
      Storing tokens in cookies is the design: part one is script-readable so
      the SPA can send it as a bearer, part two is HttpOnly so scripts can never
      reconstruct a whole token. Cookies are Secure and SameSite=Strict.
      assertHeaderSafe() rejects CR, LF and ';' in every name, value and path
      before a Set-Cookie header is written, which is what makes the manual
      header construction safe.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.util.CookieUtil"/>
        <Bug pattern="COOKIE_USAGE"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.util.CookieUtil"/>
        <Bug pattern="HTTP_RESPONSE_SPLITTING"/>
    </Match>

    <!--
      Redirect targets are built from configuration (identity.server.base.url
      plus the webapp context path), never from request input, so a caller
      cannot steer them at a phishing site.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.OAuthLoginServlet"/>
        <Bug pattern="UNVALIDATED_REDIRECT"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.service.OAuthService"/>
        <Bug pattern="UNVALIDATED_REDIRECT"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.util.PortalConfig"/>
        <Bug pattern="UNVALIDATED_REDIRECT"/>
    </Match>

    <!--
      Relayed bodies are Identity Server JSON responses written with an explicit
      application/json content type, so a browser never interprets them as HTML.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.AbstractProxyServlet"/>
        <Bug pattern="XSS_SERVLET"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.client.IdentityServerClient"/>
        <Bug pattern="XSS_SERVLET"/>
    </Match>

    <!--
      The only value logged is a filesystem path built from carbon.home, not
      from request input.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.util.PortalConfig"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      A shared, thread-safe Jackson ObjectMapper is returned intentionally;
      creating one per call is expensive and the instance is never reconfigured
      after startup.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.util.HttpUtil"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!--
      False positives from try-with-resources over a nullable resource:
      getResourceAsStream returns null when index.html is absent, and the
      compiler's generated close guard is what SpotBugs objects to. The explicit
      null check is required, not redundant - it produces the 503 that stops the
      servlet recursing during a redeploy.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.SpaServlet"/>
        <Bug pattern="NP_LOAD_OF_KNOWN_NULL_VALUE"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.SpaServlet"/>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NULL_VALUE"/>
    </Match>

    <!--
      Nominee delegation routes.

      The nominee servlets read request parameters by design - an email to
      resolve, a search term, the owner an acting session is being started for.
      None reaches a sensitive sink unchecked: each is trimmed and rejected when
      empty, SCIM2 filter values are quote-escaped by escapeFilterValue, and
      every value placed in an outbound URL is percent-encoded.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.NomineeLookupServlet"/>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.AdminUserSearchServlet"/>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.ActingSessionServlet"/>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>

    <!--
      canonicalFold and canonicalEmail are the remediation for this pattern, not
      instances of it: both normalise to NFKC before folding case, and pin the
      fold to Locale.ROOT so the result cannot vary with the JVM's default
      locale. The detector flags the toLowerCase call itself and cannot see the
      preceding normalisation. Case folding is confined to these two methods so
      the rule is reviewed in one place.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.client.ScimDirectoryClient"/>
        <Method name="canonicalEmail"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.util.TextUtil"/>
        <Method name="canonicalFold"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!--
      The acting routes read two headers deliberately. Authorization carries a
      mask token, which is cryptographically verified against the Identity
      Server's JWKS before any claim on it is read. X-Acting-Owner is only ever
      compared against the verified token's own subject, and a mismatch refuses
      the request - it can loosen nothing.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.ActingConsentServlet"/>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>

    <!--
      Relayed bodies are Consent Server JSON responses written with an explicit
      application/json content type, so a browser never interprets them as HTML.
      Same reasoning as AbstractProxyServlet above.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.ActingConsentServlet"/>
        <Bug pattern="XSS_SERVLET"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.client.ConsentServerClient$Result"/>
        <Bug pattern="XSS_SERVLET"/>
    </Match>

    <!--
      ConsentServerClient is a stateless request issuer holding only config and
      the verified tenant id; it is passed to the approval builder deliberately
      so both share one upstream identity. There is no mutable state to copy.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.service.ConsentApprovalBuilder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      The acting-start redirect targets the Identity Server's authorization
      endpoint, built from identity.server.base.url with every query parameter
      percent-encoded by ImpersonationClient.appendParam. The caller supplies
      ownerId, which lands in a query value and can never alter the scheme, host
      or path - so it cannot steer the browser to a site of the caller's choosing.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.ActingSessionServlet"/>
        <Bug pattern="UNVALIDATED_REDIRECT"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.client.ImpersonationClient"/>
        <Bug pattern="UNVALIDATED_REDIRECT"/>
    </Match>

    <!--
      The Nominee Service passthrough forwards the caller's own request. It
      reads the Authorization header and the query string by design and relays
      them verbatim, because Nominee Service authenticates the caller itself -
      the proxy makes no authorization decision and adds no credential of its
      own. The path is constrained to SAFE_PATH before use, and the relayed body
      is Nominee Service JSON written with an explicit application/json content
      type, so a browser never interprets it as HTML.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.NomineeServiceProxyServlet"/>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.NomineeServiceProxyServlet"/>
        <Bug pattern="SERVLET_QUERY_STRING"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.NomineeServiceProxyServlet"/>
        <Bug pattern="XSS_SERVLET"/>
    </Match>

    <!--
      First-party and administrative consent routes.

      Both read request input by design and relay Consent Server JSON back. The
      listing forwards only an explicit set of named query parameters, the
      catalog proxy refuses any operation not on its allowlist and constrains
      the path against SAFE_PATH first, and every relayed body is written with
      an explicit application/json content type so a browser never interprets it
      as HTML. Neither servlet trusts the caller for identity: the user and
      tenant come from a verified token, and the group a write is authorised
      against is read from the record the server itself returned.
    -->
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.MeConsentsServlet"/>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.MeConsentsServlet"/>
        <Bug pattern="XSS_SERVLET"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.ConsentApiProxyServlet"/>
        <Bug pattern="SERVLET_QUERY_STRING"/>
    </Match>
    <Match>
        <Class name="org.wso2.dpdp.accelerator.portal.webapp.servlet.ConsentApiProxyServlet"/>
        <Bug pattern="XSS_SERVLET"/>
    </Match>

</FindBugsFilter>
