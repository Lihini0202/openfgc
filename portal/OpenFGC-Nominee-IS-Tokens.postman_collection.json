              ]
            },
            "url": {
              "raw": "{{is_base}}/oauth2/token",
              "host": [
                "{{is_base}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('impersonation_access_token', j.access_token);",
                  "const cl = JSON.parse(Buffer.from(j.access_token.split('.')[1], 'base64').toString());",
                  "pm.test('sub = ' + cl.sub + '   (the OWNER)', function () { pm.expect(cl.sub).to.eql(pm.collectionVariables.get('owner_id')); });",
                  "pm.test('act.sub = ' + ((cl.act && cl.act.sub) || '-') + '   (the NOMINEE)', function () { pm.expect(cl.act).to.not.be.undefined; });",
                  "pm.test('scope = ' + cl.scope, function () { pm.expect(cl.scope).to.be.a('string'); });",
                  "const out = {",
                  "  'status': pm.response.code,",
                  "  'sub   (the OWNER)': cl.sub,",
                  "  'act.sub   (the NOMINEE)': (cl.act && cl.act.sub) || '-',",
                  "  'scope': cl.scope,",
                  "  'expires_in': j.expires_in,",
                  "  '1. LOGIN ACCESS TOKEN': pm.collectionVariables.get('login_access_token'),",
                  "  '2. SUBJECT TOKEN': pm.collectionVariables.get('subject_token'),",
                  "  '3. IMPERSONATION ACCESS TOKEN': j.access_token",
                  "};",
                  "",
                  "const rows = Object.entries(out).map(function (e) {",
                  "  return '<tr><td style=\"padding:6px 16px 6px 0;color:#777;white-space:nowrap;vertical-align:top\">'",
                  "       + e[0]",
                  "       + '</td><td style=\"padding:6px 0;font-family:monospace;font-size:12px;word-break:break-all\">'",
                  "       + e[1] + '</td></tr>';",
                  "}).join('');",
                  "pm.visualizer.set('<table style=\"font:13px sans-serif;border-collapse:collapse\">' + rows + '</table>');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "B. Negative - a non-nominee is refused",
      "description": "The same API calls, made by a valid signed-in user who was never nominated for the account they are reaching for.\n\nEvery request here is EXPECTED to be refused. A green run means the refusals happened.\n\nRun folder A first, or run the whole collection top to bottom.",
      "item": [
        {
          "name": "7 authorize as non-nominee  [302 expected]",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Drop the Identity Server session left behind by folder A.",
                  "//",
                  "// Postman keeps ONE cookie jar for the whole run, so the session cookie set",
                  "// when the nominee signed in at step 2 is still being sent. Left in place, IS",
                  "// recognises it, skips the login page entirely, and this folder re-runs as the",
                  "// NOMINEE - every assertion below then passes for the wrong reason.",
                  "const jar = pm.cookies.jar();",
                  "jar.clear(pm.collectionVariables.get('is_base'), function (err) {",
                  "  if (err) { console.log('cookie jar clear failed: ' + err); }",
                  "  else { console.log('cookie jar cleared for ' + pm.collectionVariables.get('is_base')); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '';",
                  "const m = loc.match(/sessionDataKey=([0-9a-fA-F-]{36})/);",
                  "if (m) pm.collectionVariables.set('o_session_data_key', m[1]);",
                  "pm.test('302 as expected', function () { pm.response.to.have.status(302); });",
                  "pm.test('a fresh login is demanded, not the previous session', function () { pm.expect(m).to.not.be.null; });",
                  "const out = {",
                  "  'status': pm.response.code + '   302 is correct here - do not follow it',",
                  "  'session isolation': 'two independent measures: the cookie jar is cleared in the pre-request script, and prompt=login tells IS to authenticate again regardless. Either alone is sufficient; both are kept so removing one does not silently turn this folder back into a second run of folder A.',",
                  "  'sessionDataKey': m ? m[1] : 'NOT FOUND - the previous session was reused'",
                  "};",
                  "",
                  "const rows = Object.entries(out).map(function (e) {",
                  "  return '<tr><td style=\"padding:6px 16px 6px 0;color:#777;white-space:nowrap;vertical-align:top\">'",
                  "       + e[0]",
                  "       + '</td><td style=\"padding:6px 0;font-family:monospace;font-size:12px;word-break:break-all\">'",
                  "       + e[1] + '</td></tr>';",
                  "}).join('');",
                  "pm.visualizer.set('<table style=\"font:13px sans-serif;border-collapse:collapse\">' + rows + '</table>');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{is_base}}/oauth2/authorize?response_type=code&client_id={{client_id}}&redirect_uri={{redirect_uri}}&scope={{scopes}}&prompt=login",
              "host": [
                "{{is_base}}"
              ],
              "path": [
                "oauth2",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirect_uri}}"
                },
                {
                  "key": "scope",
                  "value": "{{scopes}}"
                },
                {
                  "key": "prompt",
                  "value": "login"
                }
              ]
            },
            "description": "Starts a login for someone who is NOT a nominee of the account they will try to reach.\n\nPostman keeps ONE cookie jar for the whole run, so the Identity Server session created at step 2 is still live and still being sent. Left in place, IS recognises it, skips the login page, and this folder signs in as the NOMINEE again - every assertion below then passes for the wrong reason and the negative flow proves nothing.\n\nTwo measures prevent that, either of which works on its own:\n\n  1. the pre-request script clears the cookie jar for {{is_base}}\n  2. prompt=login asks IS to authenticate again regardless of any session\n\nBoth are kept deliberately. If one is later removed the folder still tests what it claims to test."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
