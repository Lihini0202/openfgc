                  "const loc = pm.response.headers.get('Location') || '';",
                  "const issued = loc.match(/[#&]subject_token=([^&]+)/);",
                  "const err = loc.match(/[#&]error=([^&]+)/);",
                  "pm.test('NO subject token was issued', function () { pm.expect(issued).to.be.null; });",
                  "pm.test('an error came back instead', function () { pm.expect(err).to.not.be.null; });",
                  "const out = {",
                  "  'subject token': issued ? 'ISSUED - THIS IS A BUG' : 'NOT ISSUED  <-- correct',",
                  "  'error': err ? decodeURIComponent(err[1]) : '-',",
                  "  'requested_subject': pm.collectionVariables.get('not_nominated_owner_id'),",
                  "  'requested by': pm.collectionVariables.get('outsider_id'),",
                  "  'refused by': 'NominationImpersonationValidator, inside the Identity Server',",
                  "  'reason': 'no ACTIVE nomination exists from that owner to this caller',",
                  "  'confirm in the IS log': 'WARN ... Impersonation denied: no active nomination. owner=... nominee=...',",
                  "  'what this means': 'The refusal happens BEFORE any token exists. There is nothing to replay, narrow or leak - the caller never receives credentials for that account at all.'",
                  "};",
                  "",
                  "const rows = Object.entries(out).map(function (e) {",
                  "  return '<tr><td style=\"padding:6px 16px 6px 0;color:#777;white-space:nowrap;vertical-align:top\">'",
