                  "pm.test('active = false', function () { pm.expect(b.active).to.eql(false); });",
                  "pm.test('no permissions carried', function () { pm.expect(b.permissions).to.eql([]); });",
                  "const out = {",
                  "  'active': String(b.active) + '   <-- the reason step 11 was refused',",
                  "  'permissions': JSON.stringify(b.permissions),",
                  "  'this is the same call': 'the Identity Server extension makes at mint time, and the portal backend makes on every acting request',",
                  "  'why 200 and not 404': 'absence is a valid answer to the question asked. The gate reports what is true; the caller decides what to do about it.',",
                  "  'no caching': 'read from the database per call, which is why withdrawing a nomination takes effect on the very next request rather than at token expiry'",
                  "};",
                  "",
                  "const rows = Object.entries(out).map(function (e) {",
                  "  return '<tr><td style=\"padding:6px 16px 6px 0;color:#777;white-space:nowrap;vertical-align:top\">'",
