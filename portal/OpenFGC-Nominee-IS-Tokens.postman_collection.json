  "item": [
    {
      "name": "A. Positive - a nominee acts for an owner",
      "description": "Six requests, no browser. Ends with an impersonation token: sub = owner, act = nominee.",
      "item": [
        {
          "name": "1 authorize  [302 expected]",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{is_base}}/oauth2/authorize?response_type=code&client_id={{client_id}}&redirect_uri={{redirect_uri}}&scope={{scopes}}",
              "host": [
                "{{is_base}}"
              ],
              "path": [
                "oauth2",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirect_uri}}"
                },
                {
                  "key": "scope",
                  "value": "{{scopes}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '';",
                  "const m = loc.match(/sessionDataKey=([0-9a-fA-F-]{36})/);",
                  "if (m) pm.collectionVariables.set('session_data_key', m[1]);",
                  "pm.test('302 as expected', function () { pm.response.to.have.status(302); });",
                  "pm.test('sessionDataKey captured', function () { pm.expect(m).to.not.be.null; });",
                  "pm.test('no HTML', function () { pm.expect(pm.response.text()).to.not.include('<html'); });",
                  "const out = {",
                  "  'status': pm.response.code + '   302 is correct here - do not follow it',",
                  "  'sessionDataKey': m ? m[1] : 'NOT FOUND'",
                  "};",
                  "",
                  "const rows = Object.entries(out).map(function (e) {",
                  "  return '<tr><td style=\"padding:6px 16px 6px 0;color:#777;white-space:nowrap;vertical-align:top\">'",
                  "       + e[0]",
                  "       + '</td><td style=\"padding:6px 0;font-family:monospace;font-size:12px;word-break:break-all\">'",
                  "       + e[1] + '</td></tr>';",
                  "}).join('');",
                  "pm.visualizer.set('<table style=\"font:13px sans-serif;border-collapse:collapse\">' + rows + '</table>');"
                ]
              }
            }
          ]
        },
        {
          "name": "2 authenticate  [302 expected]",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{nominee_username}}"
                },
                {
                  "key": "password",
                  "value": "{{nominee_password}}"
                },
                {
                  "key": "sessionDataKey",
                  "value": "{{session_data_key}}"
                }
              ]
            },
            "url": {
              "raw": "{{is_base}}/commonauth",
              "host": [
                "{{is_base}}"
              ],
              "path": [
                "commonauth"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '';",
                  "const ok = loc !== '' && loc.indexOf('authFailure') < 0 && loc.indexOf('login.do') < 0;",
                  "if (ok) pm.collectionVariables.set('follow_url', loc);",
                  "pm.test('302 as expected', function () { pm.response.to.have.status(302); });",
                  "pm.test('credentials accepted', function () { pm.expect(ok).to.be.true; });",
                  "pm.test('no HTML', function () { pm.expect(pm.response.text()).to.not.include('<html'); });",
                  "const out = {",
                  "  'status': pm.response.code + '   302 is correct here - do not follow it',",
                  "  'credentials': ok ? 'accepted' : 'REJECTED - check nominee_username and nominee_password'",
                  "};",
                  "",
                  "const rows = Object.entries(out).map(function (e) {",
                  "  return '<tr><td style=\"padding:6px 16px 6px 0;color:#777;white-space:nowrap;vertical-align:top\">'",
                  "       + e[0]",
                  "       + '</td><td style=\"padding:6px 0;font-family:monospace;font-size:12px;word-break:break-all\">'",
                  "       + e[1] + '</td></tr>';",
                  "}).join('');",
                  "pm.visualizer.set('<table style=\"font:13px sans-serif;border-collapse:collapse\">' + rows + '</table>');"
                ]
              }
            }
          ]
        },
        {
          "name": "3 get code  [302 expected]",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{follow_url}}",
              "host": [
                "{{follow_url}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = pm.collectionVariables.get('follow_url');",
                  "if (!u) {",
                  "  throw new Error('follow_url is empty. Step 2 did not complete. Run the whole collection from step 1 (Run Collection), not this request on its own.');",
                  "}",
                  "console.log('follow_url = ' + u);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '';",
                  "const m = loc.match(/[?&]code=([^&]+)/);",
                  "if (m) pm.collectionVariables.set('auth_code', decodeURIComponent(m[1]));",
                  "pm.test('302 as expected', function () { pm.response.to.have.status(302); });",
                  "pm.test('authorization code captured', function () { pm.expect(m).to.not.be.null; });",
                  "pm.test('no HTML', function () { pm.expect(pm.response.text()).to.not.include('<html'); });",
                  "const out = {",
                  "  'status': pm.response.code + '   302 is correct here - do not follow it',",
                  "  'authorization code': m ? decodeURIComponent(m[1]) : 'NOT FOUND'",
                  "};",
                  "",
                  "const rows = Object.entries(out).map(function (e) {",
                  "  return '<tr><td style=\"padding:6px 16px 6px 0;color:#777;white-space:nowrap;vertical-align:top\">'",
                  "       + e[0]",
                  "       + '</td><td style=\"padding:6px 0;font-family:monospace;font-size:12px;word-break:break-all\">'",
                  "       + e[1] + '</td></tr>';",
                  "}).join('');",
                  "pm.visualizer.set('<table style=\"font:13px sans-serif;border-collapse:collapse\">' + rows + '</table>');"
                ]
              }
            }
          ]
        },
        {
          "name": "4 login access token",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{client_id}}"
                },
                {
                  "key": "password",
                  "value": "{{client_secret}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "{{auth_code}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirect_uri}}"
                }
              ]
            },
            "url": {
              "raw": "{{is_base}}/oauth2/token",
              "host": [
                "{{is_base}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('login_access_token', j.access_token);",
                  "const cl = JSON.parse(Buffer.from(j.access_token.split('.')[1], 'base64').toString());",
                  "pm.test('sub = ' + cl.sub, function () { pm.expect(cl.sub).to.be.a('string'); });",
                  "pm.test('scope = ' + cl.scope, function () { pm.expect(cl.scope).to.be.a('string'); });",
                  "pm.test('no act claim - plain login token', function () { pm.expect(cl.act).to.be.undefined; });",
                  "const out = {",
                  "  'status': pm.response.code,",
                  "  'sub   (NOMINEE, as themselves)': cl.sub,",
                  "  'act claim': cl.act ? JSON.stringify(cl.act) : 'none - this is a plain login token',",
                  "  'scope': cl.scope,",
                  "  'expires_in': j.expires_in,",
                  "  'LOGIN ACCESS TOKEN': j.access_token",
                  "};",
                  "",
                  "const rows = Object.entries(out).map(function (e) {",
                  "  return '<tr><td style=\"padding:6px 16px 6px 0;color:#777;white-space:nowrap;vertical-align:top\">'",
                  "       + e[0]",
                  "       + '</td><td style=\"padding:6px 0;font-family:monospace;font-size:12px;word-break:break-all\">'",
                  "       + e[1] + '</td></tr>';",
                  "}).join('');",
                  "pm.visualizer.set('<table style=\"font:13px sans-serif;border-collapse:collapse\">' + rows + '</table>');"
                ]
              }
            }
          ]
        },
        {
          "name": "5 subject token  [302 expected]",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{is_base}}/oauth2/authorize?response_type=id_token subject_token&client_id={{client_id}}&redirect_uri={{redirect_uri}}&requested_subject={{owner_id}}&scope={{scopes}}&state=s1&nonce=n1",
              "host": [
                "{{is_base}}"
              ],
              "path": [
                "oauth2",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "id_token subject_token"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirect_uri}}"
                },
                {
                  "key": "requested_subject",
                  "value": "{{owner_id}}"
                },
                {
                  "key": "scope",
                  "value": "{{scopes}}"
                },
                {
                  "key": "state",
                  "value": "s1"
                },
                {
                  "key": "nonce",
                  "value": "n1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '';",
                  "const m = loc.match(/[#&]subject_token=([^&]+)/);",
                  "const t = m ? decodeURIComponent(m[1]) : '';",
                  "if (t) pm.collectionVariables.set('subject_token', t);",
                  "const cl = t ? JSON.parse(Buffer.from(t.split('.')[1], 'base64').toString()) : {};",
                  "pm.test('302 as expected', function () { pm.response.to.have.status(302); });",
                  "pm.test('subject token issued', function () { pm.expect(t).to.not.eql(''); });",
                  "pm.test('no HTML', function () { pm.expect(pm.response.text()).to.not.include('<html'); });",
                  "pm.test('sub = ' + (cl.sub || '-') + '   (the OWNER)', function () { pm.expect(cl.sub).to.eql(pm.collectionVariables.get('owner_id')); });",
                  "pm.test('may_act.sub = ' + ((cl.may_act && cl.may_act.sub) || '-') + '   (the NOMINEE)', function () { pm.expect(cl.may_act).to.not.be.undefined; });",
                  "const out = {",
                  "  'status': pm.response.code + '   302 is correct - the token rides in the Location fragment',",
                  "  'sub   (the OWNER)': cl.sub || '-',",
                  "  'may_act.sub   (the NOMINEE)': (cl.may_act && cl.may_act.sub) || '-',",
                  "  'scope   (narrowed to what the owner granted)': cl.scope || '-',",
                  "  'SUBJECT TOKEN': t || 'NOT ISSUED'",
                  "};",
                  "",
                  "const rows = Object.entries(out).map(function (e) {",
                  "  return '<tr><td style=\"padding:6px 16px 6px 0;color:#777;white-space:nowrap;vertical-align:top\">'",
                  "       + e[0]",
                  "       + '</td><td style=\"padding:6px 0;font-family:monospace;font-size:12px;word-break:break-all\">'",
                  "       + e[1] + '</td></tr>';",
                  "}).join('');",
                  "pm.visualizer.set('<table style=\"font:13px sans-serif;border-collapse:collapse\">' + rows + '</table>');"
                ]
              }
            }
          ]
        },
        {
          "name": "6 impersonation access token",
          "protocolProfileBehavior": {
