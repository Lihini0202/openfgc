            },
            "url": {
              "raw": "{{nominee_service}}/me/nominees",
              "host": [
                "{{nominee_service}}"
              ],
              "path": [
                "me",
                "nominees"
              ]
            },
            "description": "Additive — existing nominees are untouched. Nominating the same person twice returns 409 DUPLICATE_NOMINATION."
          }
        },
        {
