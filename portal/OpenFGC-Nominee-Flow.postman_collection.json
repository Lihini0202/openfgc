                "nominees"
              ]
            },
            "description": "Returns a LIST. An owner may nominate any number of people, each with its own permissions and status."
          }
        },
        {
          "name": "Owner: add a nominee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
