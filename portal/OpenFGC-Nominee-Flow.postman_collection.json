                  "key": "id",
                  "value": "NOMINATION_ID_HERE"
                }
              ]
            },
            "description": "Only affects this nominee. Scoped to the owner — you cannot edit someone else's nomination even with a valid id (returns 404)."
          }
        },
        {
          "name": "Owner: remove one nominee",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{nominee_service}}/me/nominees/:id",
              "host": [
                "{{nominee_service}}"
              ],
              "path": [
                "me",
                "nominees",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "NOMINATION_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Nominee: nominations assigned to me",
